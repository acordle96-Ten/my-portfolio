---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout>
  <section class="grid flex-1 content-center gap-12 py-20 md:grid-cols-[1.3fr_0.7fr] md:items-end">
    <div>
      <p class="mb-6 text-sm font-semibold uppercase text-[#356c58]">Independent designer &amp; developer</p>
      <h1 class="text-4xl font-bold">Hello, I'm Your Name</h1>
    </div>
    <div class="max-w-sm md:justify-self-end">
      <p class="text-lg leading-relaxed text-[#202723]/75">
        I’m building a portfolio of useful, clear, and characterful experiences. This is the starting point.
      </p>
      <a class="mt-7 inline-flex items-center gap-3 text-sm font-semibold" href="mailto:hello@example.com">
        Start a conversation <span aria-hidden="true" class="text-[#e56f45]">↗</span>
      </a>
    </div>
  </section>
</Layout>
